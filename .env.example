PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_crm
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
CORS_ORIGIN=*

# AI (optional - heuristic fallback is used when no key is set). AI_PROVIDER=openai|gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email (optional - messages are simulated/logged when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=crm@example.com

# SMS / WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Shared secret for inbound WhatsApp/email webhooks
WEBHOOK_SECRET=change-me-webhook

# Set to false to disable the background scheduler
SCHEDULER_ENABLED=true

# Communication Hub (bulk SMS / WhatsApp / IVR). Providers are set per company in the panel.
# Public https address of this server: needed for outbound IVR calls, delivery reports and Twilio signature checks.
PUBLIC_URL=
# Encrypts provider credentials at rest (defaults to a key derived from JWT_ACCESS_SECRET; changing it means re-entering credentials).
ENCRYPTION_KEY=
# Country code added to 10-digit local numbers.
DEFAULT_COUNTRY_CODE=91

# Platform owner / licensing
# false = only you (owner console at /owner.html) can create companies; the public "Create account" link disappears.
ALLOW_SIGNUP=true
OWNER_TOKEN_TTL=12h
# Days the desktop app keeps working without reaching the server before it must re-check its licence.
OFFLINE_GRACE_DAYS=7
# Where built desktop installers are served from (/downloads). Default: ./downloads
DOWNLOADS_DIR=
