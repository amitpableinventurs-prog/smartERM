PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_crm
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
CORS_ORIGIN=*

# AI (optional - heuristic fallback is used when no key is set). AI_PROVIDER=openai|gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email (optional - messages are simulated/logged when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=crm@example.com

# SMS / WhatsApp via Twilio (optional). Also offered for IVR calls: Channel Providers > Voice > Connect Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Shared secret for inbound WhatsApp/email webhooks
WEBHOOK_SECRET=change-me-webhook

# Set to false to disable the background scheduler
SCHEDULER_ENABLED=true

# Communication Hub (bulk SMS / WhatsApp / IVR). Providers are set per company in the panel.
# Public https address of this server: needed for outbound IVR calls, delivery reports and Twilio signature checks.
PUBLIC_URL=
# Encrypts provider credentials at rest (defaults to a key derived from JWT_ACCESS_SECRET; changing it means re-entering credentials).
ENCRYPTION_KEY=
# Country code added to 10-digit local numbers.
DEFAULT_COUNTRY_CODE=91

# Platform owner / licensing
# false = only you (owner console at /owner.html) can create companies; the public "Create account" link disappears.
ALLOW_SIGNUP=true
OWNER_TOKEN_TTL=12h
# Days the desktop app keeps working without reaching the server before it must re-check its licence.
OFFLINE_GRACE_DAYS=7
# Where built desktop installers are served from (/downloads). Default: ./downloads
DOWNLOADS_DIR=

# Ad network APIs (optional). Companies connect their own ad accounts under Ads > Ad accounts > Connect API.
# Google Ads: developer token from your manager (MCC) account's API Center, used for every company unless they set their own.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client (Google Cloud console, type "Web application") with redirect URI <PUBLIC_URL>/api/oauth/google-ads/callback.
# With it set, companies click "Sign in with Google" instead of pasting a refresh token.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Manager account ID, if client accounts are reached through it (123-456-7890).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26
# Meta Marketing API / WhatsApp Cloud API Graph version.
META_GRAPH_VERSION=v23.0
# "Connect with Facebook" for ad accounts: a Meta app (developers.facebook.com) with Facebook Login for Business and the
# Marketing API. Add <PUBLIC_URL>/api/oauth/meta/callback to its Valid OAuth Redirect URIs.
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration ID (system-user token, never expires). Without it tokens last 60 days.
META_LOGIN_CONFIG_ID=
